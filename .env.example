# LAN IP of this machine so a physical phone can reach Metro and mock-api.
# Replace with your IPv4 address (ipconfig / ifconfig). Never commit real secrets.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10

# Public API used by the phone. Must be reachable from the device, not "localhost".
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# false = repositories "real" talking to mock-api (Docker default)
# true  = in-memory mocks (Jest / local UI without API)
EXPO_PUBLIC_USE_MOCKS=false

# true = live STPT Timisoara positions for buses (rest stays on mocks)
EXPO_PUBLIC_USE_REAL_BUS=false


# Serverul real (api-app.md): EXPO_PUBLIC_API_URL = http://<server>:3000 (fără /api/v1; aplicația îl adaugă).
# Procesatorul de plăți al serverului e fals: true = carduri de test în aplicație (NU în producție).
EXPO_PUBLIC_TEST_PAYMENTS=false
# Doar server de test: idToken fix pentru Google/Apple (ex. test:alice) până există SDK-ul real.
EXPO_PUBLIC_TEST_ID_TOKEN=
# Doar server de test: X-User-Id în loc de login (lasă gol cu serverul real).
EXPO_PUBLIC_TEST_USER_ID=

# Doar test/demo: DISPLAY_TOKEN al serverului EchoPass, ca harta să arate autobuzele de test ale serverului
# (poziție GPS + persoane numărate de cameră). Ajunge în APK — nu-l pune într-un build public.
# EXPO_PUBLIC_DISPLAY_TOKEN=
# Autobuzele serverului arătate pe hartă: bus_id:linie, separate prin virgulă (implicit 101:E2).
# EXPO_PUBLIC_SERVER_BUSES=101:E2
